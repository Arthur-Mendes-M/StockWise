{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "rootDir": "./src",
    "moduleResolution": "nodenext",
    "allowJs": true,
    "checkJs": true,
    // Remove the following line as it's not compatible with your current setup
    // "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
  },
  "include": ["src", "src/server.ts"],
  "exclude": ["node_modules"],
  }